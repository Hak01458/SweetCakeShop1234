@page
@model SweetCakeShop.Areas.Identity.Pages.Account.Manage.OrdersModel
@using SweetCakeShop.Models
@using System.Globalization

@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-center" style="color:#d81b60">
        <i class="bi bi-bag-heart-fill"></i>
        LỊCH SỬ MUA HÀNG
    </h2>

    @if (!Model.Orders.Any())
    {
        <div class="card border-0 shadow text-center p-5 rounded-4">

            <i class="bi bi-cart-x text-secondary" style="font-size:70px"></i>

            <h4 class="mt-3">
                Bạn chưa có đơn hàng nào
            </h4>

            <a href="/Products"
               class="btn btn-pink mt-3 px-4">

                Mua sắm ngay

            </a>

        </div>
    }
    else
    {
        foreach (var order in Model.Orders)
        {


            <div class="card order-card mb-5">

                <!-- HEADER -->

                <div class="order-header p-4">

                    <div class="row align-items-center">

                        <div class="col-md-8">

                            <h4 class="fw-bold text-danger mb-1">

                                📦 Đơn hàng #@order.OrderId

                            </h4>

                            <div class="text-muted">

                                <i class="bi bi-calendar-event"></i>

                                @order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")

                            </div>

                        </div>

                        <div class="col-md-4 text-md-end mt-3 mt-md-0">

                            <span class="badge rounded-pill bg-danger px-3 py-2">

                                @order.Status

                            </span>

                            <h4 class="mt-2 text-danger fw-bold">

                                @order.TotalPrice.ToString("C0", new CultureInfo("vi-VN"))

                            </h4>

                        </div>

                    </div>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrEmpty(order.GhnOrderCode))
                    {

                        <div class="shipping-box p-4 mb-4">

                            <div class="row">

                                <div class="col-md-8">

                                    <h5 class="fw-bold mb-3">

                                        🚚 Giao Hàng Nhanh

                                    </h5>

                                    <p>

                                        <strong>Mã vận đơn:</strong>

                                        @order.GhnOrderCode

                                    </p>

                                    <p>

                                        <strong>Phí vận chuyển:</strong>

                                        @order.ShippingFee.ToString("C0", new CultureInfo("vi-VN"))

                                    </p>

                                    <p>

                                        <strong>Dự kiến giao:</strong>

                                        @(order.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "--")

                                    </p>

                                </div>

                                <div class="col-md-4 text-md-end">

                                    @switch (order.ShippingStatus)
                                    {
                                        case "ready_to_pick":

                                            <span class="badge bg-primary status-badge">

                                                Chờ lấy hàng

                                            </span>

                                            break;

                                        case "delivering":

                                            <span class="badge bg-warning text-dark status-badge">

                                                Đang giao

                                            </span>

                                            break;

                                        case "delivered":

                                            <span class="badge bg-success status-badge">

                                                Đã giao

                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-secondary status-badge">

                                                @order.ShippingStatus

                                            </span>

                                            break;
                                    }

                                    <br />

                                    <a href="@order.TrackingUrl"
                                       target="_blank"
                                       class="btn btn-pink mt-3">

                                        Theo dõi GHN

                                    </a>

                                </div>

                            </div>

                        </div>
                        
                        <!-- TIMELINE -->

                        <div class="shipping-timeline mb-5">
                            @{
                                int currentStep = 1;

                                switch (order.ShippingStatus)
                                {
                                    case "ready_to_pick":
                                        currentStep = 2;
                                        break;

                                    case "picking":
                                        currentStep = 3;
                                        break;

                                    case "transporting":
                                    case "delivering":
                                        currentStep = 4;
                                        break;

                                    case "delivered":
                                        currentStep = 5;
                                        break;
                                }
                            }

                            <div class="timeline-item @(currentStep >= 1 ? "completed" : "")">
                                <div class="circle">
                                    <i class="bi bi-cart-check"></i>
                                </div>
                                <span>Đặt hàng</span>
                            </div>

                            <div class="timeline-line @(currentStep >= 2 ? "completed" : "")"></div>

                            <div class="timeline-item @(currentStep >= 2 ? "completed" : "")">
                                <div class="circle">
                                    <i class="bi bi-credit-card"></i>
                                </div>
                                <span>Thanh toán</span>
                            </div>

                            <div class="timeline-line @(currentStep >= 3 ? "completed" : "")"></div>

                            <div class="timeline-item @(currentStep >= 3 ? "completed" : "")">
                                <div class="circle">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <span>GHN tiếp nhận</span>
                            </div>

                            <div class="timeline-line @(currentStep >= 4 ? "completed" : "")"></div>

                            <div class="timeline-item @(currentStep >= 4 ? "completed" : "")">
                                <div class="circle">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <span>Đang giao</span>
                            </div>

                            <div class="timeline-line @(currentStep >= 5 ? "completed" : "")"></div>

                            <div class="timeline-item @(currentStep >= 5 ? "completed" : "")">
                                <div class="circle">
                                    <i class="bi bi-house-check"></i>
                                </div>
                                <span>Hoàn tất</span>
                            </div>

                        </div>
                        @if (order.ShippingStartTime != null &&
     order.DeliverySimulationTime != null &&
     order.Status != "Delivered")
                        {
                            var totalSeconds =
                                (order.DeliverySimulationTime.Value - order.ShippingStartTime.Value).TotalSeconds;

                            var currentSeconds =
                                (DateTime.Now - order.ShippingStartTime.Value).TotalSeconds;

                            var percent =
                                (int)Math.Min(100,
                                    Math.Max(0, currentSeconds / totalSeconds * 100));

                            <div class="mt-4">

                                <div class="d-flex justify-content-between">

                                    <strong>Tiến độ giao hàng</strong>

                                    <strong>@percent%</strong>

                                </div>

                                <div class="progress mt-2" style="height:12px">

                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                         style="width:@percent%">
                                    </div>

                                </div>

                            </div>
                        }

                    }

                    <h5 class="fw-bold mb-3">

                        🧁 Chi tiết sản phẩm

                    </h5>

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>

                                <tr>

                                    <th>Sản phẩm</th>

                                    <th class="text-center">SL</th>

                                    <th class="text-end">Đơn giá</th>

                                    <th class="text-end">Tổng</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var d in order.OrderDetails)
                                {

                                    <tr>

                                        <td>

                                            <div class="d-flex align-items-center">

                                                <img src="@d.Product?.Image"
                                                     class="product-img me-3" />

                                                <div>

                                                    <strong>

                                                        @(d.Product?.ProductName ?? "(Đã xóa)")

                                                    </strong>

                                                </div>

                                            </div>

                                        </td>

                                        <td class="text-center">

                                            x @d.Quantity

                                        </td>

                                        <td class="text-end">

                                            @d.Price.ToString("C0", new CultureInfo("vi-VN"))

                                        </td>

                                        <td class="text-end fw-bold text-danger">

                                            @((d.Price * d.Quantity).ToString("C0", new CultureInfo("vi-VN")))

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        }
    }

</div>

<style>

    .order-card {
        border: none;
        border-radius: 25px;
        box-shadow: 0 10px 35px rgba(0,0,0,.08);
        transition: .3s;
    }

        .order-card:hover {
            transform: translateY(-5px);
        }

    .order-header {
        background: linear-gradient(90deg,#fff3f8,#fff);
        border-bottom: 1px solid #ffe4ef;
    }

    .shipping-box {
        background: #fff5f8;
        border-radius: 20px;
        border: 1px solid #ffd4e6;
    }

    .status-badge {
        padding: 8px 20px;
        font-size: 14px;
        border-radius: 30px;
    }

    .btn-pink {
        background: #d81b60;
        color: white;
        border-radius: 30px;
        font-weight: bold;
    }

        .btn-pink:hover {
            background: #c2185b;
            color: white;
        }

    .timeline {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .shipping-timeline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 30px;
    }

    .timeline-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 120px;
        text-align: center;
    }

        .timeline-item span {
            margin-top: 10px;
            font-size: 13px;
            font-weight: 600;
        }

    .timeline-line {
        flex: 1;
        height: 5px;
        background: #ddd;
        border-radius: 20px;
    }


    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 110px;
    }

    .completed .circle {
        background: #28a745;
    }

    .timeline-line.completed {
        background: #28a745;
    }

    .progress {
        border-radius: 30px;
    }

    .progress-bar {
        border-radius: 30px;
    }

    .circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #d6d6d6;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 22px;
        transition: .3s;
    }

    .active .circle {
        background: #28a745;
    }

    .line {
        flex: 1;
        height: 3px;
        background: #ddd;
    }

    .product-img {
        width: 65px;
        height: 65px;
        border-radius: 15px;
        object-fit: cover;
        border: 1px solid #eee;
    }

    thead {
        background: #fff5f8;
    }

    table {
        margin-bottom: 0;
    }

</style>