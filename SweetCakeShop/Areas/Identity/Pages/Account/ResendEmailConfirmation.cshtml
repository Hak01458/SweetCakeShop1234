@page
@model ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Gửi lại email xác nhận";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-lg"
                 style="border-radius: 24px; overflow: hidden;">

                <div style="height: 7px;
                    background: linear-gradient(90deg, #f06292, #d81b60);">
                </div>

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="mb-3" style="font-size: 3rem;">
                            ✉️
                        </div>

                        <h1 style="color: #d81b60;
                            font-weight: bold;
                            font-size: 1.7rem;">
                            Gửi lại email xác nhận
                        </h1>

                        <p class="text-muted mb-0">
                            Nhập email đã đăng ký để nhận lại liên kết xác nhận tài khoản.
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        var alertClass = Model.StatusType == "success"
                            ? "alert-success"
                            : Model.StatusType == "info"
                                ? "alert-info"
                                : "alert-danger";

                        <div class="alert @alertClass"
                             role="alert"
                             style="border-radius: 12px;">

                            @Model.StatusMessage
                        </div>
                    }

                    <form method="post"
                          id="resend-confirmation-form">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Email"
                                   class="form-label fw-bold">
                                Email đã đăng ký
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control p-3"
                                   autocomplete="email"
                                   placeholder="name@gmail.com"
                                   style="border-radius: 12px;" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <button type="submit"
                                id="resend-button"
                                class="btn btn-lg text-white w-100 shadow-sm"
                                style="background-color: #d81b60;
                            border-radius: 12px;
                            font-weight: bold;
                            border: none;">

                            Gửi email xác nhận
                        </button>

                        <a asp-page="./Login"
                           class="btn btn-outline-secondary w-100 mt-3"
                           style="border-radius: 12px;">

                            Quay lại đăng nhập
                        </a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("resend-confirmation-form");
            const button = document.getElementById("resend-button");

            form.addEventListener("submit", function() {
                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;
                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>' +
                    'Đang gửi...';
            });
        });
    </script>
}