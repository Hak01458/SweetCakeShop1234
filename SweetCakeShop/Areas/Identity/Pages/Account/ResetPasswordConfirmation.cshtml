@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 65vh;">

        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg"
                 style="border-radius: 25px; overflow: hidden;">

                <div style="height: 7px;
                    background: linear-gradient(
                    90deg,
                    #f06292,
                    #d81b60);">
                </div>

                <div class="card-body text-center p-4 p-md-5">

                    <div class="d-inline-flex align-items-center
                        justify-content-center mb-4"
                         style="width: 90px;
                        height: 90px;
                        border-radius: 50%;
                        background-color: #fff0f5;
                        font-size: 3rem;">
                        🎉
                    </div>

                    <h1 class="mb-3"
                        style="color: #d81b60;
                        font-weight: bold;
                        font-size: 1.7rem;">

                        Đặt lại mật khẩu thành công!
                    </h1>

                    <p class="text-muted mb-4"
                       style="font-size: 1rem;
                        line-height: 1.7;">

                        Mật khẩu của bạn đã được thay đổi.
                        Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.
                    </p>

                    <!-- Chuyển đến trang đăng nhập -->
                    <a asp-page="./Login"
                       class="btn btn-lg text-white w-100 shadow-sm mb-3"
                       style="background-color: #d81b60;
                        border-radius: 12px;
                        font-weight: bold;
                        padding: 12px;
                        border: none;">

                        Đăng nhập ngay
                    </a>

                    <!-- Trở về trang chủ -->
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100"
                       style="border-radius: 12px;
                        padding: 11px;
                        font-weight: 600;">

                        Trở về trang chủ
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>