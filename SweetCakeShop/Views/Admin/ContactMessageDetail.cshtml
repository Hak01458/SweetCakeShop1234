@model SweetCakeShop.Models.ContactMessage

@{
    ViewData["Title"] = "Chi tiết tin nhắn";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Chi tiết tin nhắn</h1>
        <a asp-controller="Admin" asp-action="ContactMessages" class="btn btn-outline-secondary">← Danh sách</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-6"><strong>Họ tên:</strong> @Model.Name</div>
                <div class="col-md-6"><strong>Ngày gửi:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-6"><strong>Email:</strong> @Model.Email</div>
                <div class="col-md-6"><strong>Số điện thoại:</strong> @(Model.Phone ?? "(Không có)")</div>
            </div>
            <div class="mb-3">
                <strong>Chủ đề:</strong> @(string.IsNullOrEmpty(Model.Subject) ? "(Không có)" : Model.Subject)
            </div>
            <div class="mb-0">
                <strong>Nội dung:</strong>
                <p class="mt-2 p-3 bg-light rounded">@Model.Message</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.AdminReply))
    {
        <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;border-left:4px solid #28a745 !important;">
            <div class="card-body">
                <h6 class="fw-bold text-success">Đã phản hồi lúc @Model.RepliedAt?.ToString("dd/MM/yyyy HH:mm")</h6>
                <p class="mb-0">@Model.AdminReply</p>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-body">
            <h5 class="fw-bold mb-3">@(string.IsNullOrEmpty(Model.AdminReply) ? "Viết phản hồi" : "Sửa phản hồi")</h5>
            <form asp-controller="Admin" asp-action="ReplyMessage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contactMessageId" value="@Model.ContactMessageId" />
                <div class="mb-3">
                    <textarea name="adminReply" class="form-control" rows="4" placeholder="Nhập nội dung phản hồi cho khách hàng...">@Model.AdminReply</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Lưu phản hồi</button>
            </form>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="DeleteMessage" method="post" class="mt-3"
          onsubmit="return confirm('Bạn có chắc muốn xóa tin nhắn này?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="contactMessageId" value="@Model.ContactMessageId" />
        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa tin nhắn</button>
    </form>
</div>