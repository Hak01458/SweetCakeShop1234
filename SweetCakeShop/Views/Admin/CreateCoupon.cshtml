@model SweetCakeShop.Models.Coupon
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm mã giảm giá";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Thêm mã giảm giá</h5>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }

                    <form asp-action="CreateCoupon" asp-controller="Admin" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Mã giảm giá <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control" maxlength="50" required asp-for="Code" placeholder="VD: SUMMER2024" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phần trăm giảm <span class="text-danger">*</span></label>
                                <input type="number" name="DiscountPercent" class="form-control" min="0" max="100" step="0.01" required asp-for="DiscountPercent" />
                                <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Áp dụng cho <span class="text-danger">*</span></label>
                                <select name="CustomerType" class="form-select" required asp-for="CustomerType">
                                    <option value="">-- Chọn --</option>
                                    <option value="VIP">VIP</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ngày hết hạn</label>
                            <input type="date" name="ExpiryDate" class="form-control" asp-for="ExpiryDate" />
                            <small class="form-text text-muted">Để trống nếu không có thời hạn</small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" checked />
                                <label class="form-check-label" for="isActive">
                                    Kích hoạt ngay
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Thêm mới</button>
                            <a asp-action="Coupons" asp-controller="Admin" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
