@{
    ViewData["Title"] = "Chăm sóc khách hàng";
    Layout = "_AdminLayout";
    int unread = ViewBag.UnreadContactCount ?? 0;
    int totalContact = ViewBag.TotalContactCount ?? 0;
    int totalReview = ViewBag.TotalReviewCount ?? 0;
}

<div class="container-fluid mt-4">
    <h1 class="fw-bold mb-4">Chăm sóc khách hàng</h1>

    <div class="row g-4">
        <!-- Đã sửa col-lg-3 thành col-md-6 -->
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="ContactMessages" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-0" style="border-radius:12px;">
                    <div class="card-body">
                        <h5 class="fw-bold text-dark">Phản hồi khách hàng</h5>
                        <p class="text-muted small mb-2">Tin nhắn gửi từ trang Liên hệ</p>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-3 fw-bold">@totalContact</span>
                            @if (unread > 0)
                            {
                                <span class="badge bg-danger">@unread chưa đọc</span>
                            }
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Đã sửa col-lg-3 thành col-md-6 -->
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="ProductReviews" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-0" style="border-radius:12px;">
                    <div class="card-body">
                        <h5 class="fw-bold text-dark">Đánh giá sản phẩm</h5>
                        <p class="text-muted small mb-2">Xem và kiểm duyệt đánh giá của khách</p>
                        <div class="fs-3 fw-bold">@totalReview</div>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>