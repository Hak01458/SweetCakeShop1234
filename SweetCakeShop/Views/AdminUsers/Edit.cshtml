@model SweetCakeShop.Models.ViewModels.AdminEditUserViewModel
@{
    ViewData["Title"] = "Sửa người dùng";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="AdminUsers"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết
                </a>
                <h2 class="mt-2 mb-1">Sửa thông tin người dùng</h2>
                <p class="text-muted mb-0">
                    Email cũng được dùng làm tên đăng nhập.
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="AdminUsers"
                      asp-action="Edit"
                      method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Ví dụ: 0901234567"
                               autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="User">User - Khách hàng</option>
                            <option value="Admin">Admin - Quản trị viên</option>
                        </select>
                        <span asp-validation-for="Role"
                              class="text-danger small"></span>
                        <div class="form-text">
                            Không thể tự gỡ quyền Admin của tài khoản đang đăng nhập,
                            và hệ thống luôn phải còn ít nhất một Admin.
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="EmailConfirmed"
                               class="form-check-input" />
                        <label asp-for="EmailConfirmed"
                               class="form-check-label"></label>
                    </div>

                    <hr class="my-4" />

                    <h5 class="fw-bold mb-2">Đổi mật khẩu</h5>
                    <p class="text-muted small">
                        Để trống hai ô dưới nếu không muốn đổi mật khẩu.
                        Admin không cần biết mật khẩu cũ của người dùng.
                    </p>

                    <div class="mb-3">
                        <label asp-for="NewPassword"
                               class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Nhập mật khẩu mới" />
                        <span asp-validation-for="NewPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>Lưu thay đổi
                        </button>

                        <a asp-controller="AdminUsers"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary px-4">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
