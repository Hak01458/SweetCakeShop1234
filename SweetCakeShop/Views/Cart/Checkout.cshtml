@model SweetCakeShop.Models.ViewModels.CheckoutViewModel
@using SweetCakeShop.Models.ViewModels

@{
    ViewData["Title"] = "Checkout";
    var cart = ViewData["Cart"] as CartViewModel ?? new CartViewModel();
}

<div class="container my-5">
    <h2 class="mb-4">Xác nhận đơn hàng</h2>

    <div class="row">
        <div class="col-md-6">
            <h5>Thông tin giao hàng</h5>
            <form asp-action="CheckoutConfirm" method="post">
                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    <input asp-for="CustomerName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="CustomerEmail" class="form-control" type="email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input asp-for="CustomerPhone" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ giao hàng</label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="3" required></textarea>
                </div>
                <!-- THÊM VÀO ĐÂY -->
                <div class="mb-3">
                    <label class="form-label">Tỉnh / Thành phố</label>

                    <select asp-for="ProvinceId" id="province" class="form-control">
                        <option value="">-- Chọn tỉnh/thành --</option>
                    </select>

                    <input type="hidden" asp-for="Province" id="provinceName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Quận / Huyện</label>

                    <select asp-for="DistrictId" id="district" class="form-control">
                        <option value="">-- Chọn quận/huyện --</option>
                    </select>

                    <input type="hidden" asp-for="District" id="districtName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phường / Xã</label>

                    <select asp-for="WardCode" id="ward" class="form-control">
                        <option value="">-- Chọn phường/xã --</option>
                    </select>

                    <input type="hidden" asp-for="Ward" id="wardName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phí giao hàng</label>
                    <input id="shipping-fee-display" class="form-control" readonly value="Chọn phường/xã để tính phí" />
                    <input type="hidden" asp-for="ShippingFee" id="shipping-fee-value" />
                </div>
                <!-- HẾT PHẦN THÊM -->

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
                    <button type="submit" class="btn btn-success">Đặt hàng</button>
                </div>
            </form>
        </div>

        <div class="col-md-6">
            <h5>Đơn hàng</h5>
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cart.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Price.ToString("N0") ₫</td>
                            <td>@item.Quantity</td>
                            <td>@item.Subtotal.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                        <td class="fw-bold">@cart.TotalAmount.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
    <div id="toast-container"></div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {

        const province = document.getElementById("province");
        const district = document.getElementById("district");
        const ward = document.getElementById("ward");

        const provinceName = document.getElementById("provinceName");
        const districtName = document.getElementById("districtName");
        const wardName = document.getElementById("wardName");

        // ==========================
        // Load Province
        // ==========================
        fetch("/Address/Provinces")
            .then(res => res.json())
            .then(data => {

                data.forEach(p => {

                    const option = document.createElement("option");

                    option.value = p.provinceID;
                    option.text = p.provinceName;

                    province.appendChild(option);

                });

            })
            .catch(err => {
                console.error(err);
                showToast("Không tải được danh sách tỉnh/thành.", "danger");
            });

        // ==========================
        // Province Changed
        // ==========================
        province.addEventListener("change", function() {

            provinceName.value = "";

            districtName.value = "";

            wardName.value = "";

            district.innerHTML =
                '<option value="">-- Chọn quận/huyện --</option>';

            ward.innerHTML =
                '<option value="">-- Chọn phường/xã --</option>';

            if (!this.value)
                return;

            provinceName.value =
                this.options[this.selectedIndex].text;

            fetch(`/Address/Districts/${this.value}`)
                .then(res => res.json())
                .then(data => {

                    data.forEach(d => {

                        const option = document.createElement("option");

                        option.value = d.districtID;
                        option.text = d.districtName;

                        district.appendChild(option);

                    });

                })
                .catch(err => {

                    console.error(err);

                    showToast("Không tải được danh sách quận/huyện.", "danger");

                });

        });

        // ==========================
        // District Changed
        // ==========================
        district.addEventListener("change", function() {

            districtName.value = "";

            wardName.value = "";

            ward.innerHTML =
                '<option value="">-- Chọn phường/xã --</option>';

            if (!this.value)
                return;

            districtName.value =
                this.options[this.selectedIndex].text;

            fetch(`/Address/Wards/${this.value}`)
                .then(res => res.json())
                .then(data => {

                    data.forEach(w => {

                        const option = document.createElement("option");

                        option.value = w.wardCode;
                        option.text = w.wardName;

                        ward.appendChild(option);

                    });

                })
                .catch(err => {

                    console.error(err);

                    showToast("Không tải được danh sách phường/xã.", "danger");

                });

        });

        // ==========================
        // Ward Changed
        // ==========================
        ward.addEventListener("change", function() {

            wardName.value = "";

            if (!this.value)
                return;

            wardName.value = this.options[this.selectedIndex].text;

            fetch(`/Cart/CalculateShippingFee?districtId=${district.value}&wardCode=${this.value}`)
                .then(res => res.json())
                .then(data => {

                    if (!data.success) {
                        showToast(data.message, "danger");
                        return;
                    }

                    document.getElementById("shipping-fee-display").value =
                        Number(data.shippingFee).toLocaleString("vi-VN") + " ₫";

                    document.getElementById("shipping-fee-value").value =
                        data.shippingFee;

                })
                .catch(err => {

                    console.error(err);

                    showToast("Không tính được phí giao hàng.", "danger");

                });

        });
    });
</script>
<script>
    function showToast(message, type = 'info', delay = 3000) {
        // type: 'info', 'success', 'danger', 'warning'
        const toastId = 't' + Date.now();
        const colorClass = {
            info: 'bg-info text-white',
            success: 'bg-success text-white',
            danger: 'bg-danger text-white',
            warning: 'bg-warning text-dark'
        }[type] || 'bg-info text-white';

        const wrapper = document.createElement('div');
        wrapper.innerHTML = `
            <div id="${toastId}" class="toast ${colorClass} align-items-center border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="${delay}">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>`;
        document.getElementById('toast-container')?.appendChild(wrapper);

        var toastEl = document.getElementById(toastId)
        var toast = new bootstrap.Toast(toastEl)
        toast.show()

        // remove after hidden
        toastEl.addEventListener('hidden.bs.toast', function () {
            toastEl.remove();
        });
    }
</script>